# ACE Backend — local development (copy to .env.local and fill secrets locally).
# Never commit .env.local or production credentials.

# --- Required for local dev mode (loopback only) ---
ACE_LOCAL_DEV_ENABLED=true
ACE_SECURITY_ENABLED=false
PORT=5000

# One-click start (Windows):
#   Backend: scripts\Start-AceBackendLocal.cmd
#   Worker (Builder2): scripts\Start-AceWorkerLocal.cmd

# --- Do NOT point at Render / production ---
# Leave REDIS_URL unset for Builder1-only (in-memory). For Builder2 later use loopback only:
# REDIS_URL=redis://127.0.0.1:6379/0
ACE_PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- API keys (set in .env.local only; placeholders here) ---
# OPENAI_API_KEY=
# RUNWAY_API_KEY=

# --- Keep production flags off locally ---
# BUILDER1_PRODUCTION_MODE=false
